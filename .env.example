# Copy to .env.local and fill in. Leave Supabase empty to run in demo mode.

# Supabase → Project Settings → API (or "Connect" button)
NEXT_PUBLIC_SUPABASE_URL=
# New projects show a "publishable" key; older ones show "anon". Either works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: public URL used in auth emails. Vercel sets this automatically in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI via Vercel AI Gateway. On Vercel it authenticates automatically (OIDC).
# Locally: create a key at vercel.com → AI Gateway, or run `vercel env pull`.
AI_GATEWAY_API_KEY=
# Any gateway model id, e.g. anthropic/claude-sonnet-5.5, openai/gpt-5, google/gemini-3-flash
AI_MODEL=anthropic/claude-sonnet-5.5

# Agora Conversational AI Engine: Uncle's live voice on /onboarding. Leave empty and the page
# uses the browser's own voice ("Demo voice"). All of these stay on the server.
# Agora Console → Projects → your project: App ID and Primary Certificate (enable the certificate).
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
# Agora Console → Developer Toolkit → RESTful API → Add a secret (Customer ID + Customer Secret).
# Also enable Conversational AI for the project in Agora Console.
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=
# Any OpenAI-compatible chat completions endpoint, e.g. https://api.openai.com/v1/chat/completions
AGORA_LLM_URL=
AGORA_LLM_API_KEY=
AGORA_LLM_MODEL=gpt-4o-mini
# TTS: "microsoft" (Azure Speech key + region) or "elevenlabs" (API key + voice id in AGORA_TTS_VOICE).
AGORA_TTS_VENDOR=microsoft
AGORA_TTS_KEY=
# Azure: a neural voice name (default ms-MY-OsmanNeural, Malaysian male). ElevenLabs: a voice_id.
AGORA_TTS_VOICE=ms-MY-OsmanNeural
# Azure only: the region of your Speech resource.
AGORA_TTS_REGION=southeastasia
# ElevenLabs only: model id.
AGORA_TTS_MODEL=eleven_flash_v2_5
# ASR: "ares" (Agora built-in, no extra key) or "microsoft" (reuses the Azure key/region above).
AGORA_ASR_VENDOR=ares
# BCP-47. en-US for ARES; with microsoft you can try ms-MY for BM-heavy speakers.
AGORA_ASR_LANGUAGE=en-US

# First Key map: URL (or site path, e.g. /tiles/seri-kopi.pmtiles) of our own PMTiles basemap. Leave empty and /find still renders the township on a plain background.
NEXT_PUBLIC_PMTILES_URL=

# Feng Shui Builder AI (command box + voice). With GROQ_API_KEY set, both run on Groq; without it they use the AI Gateway.
GROQ_API_KEY=
# Optional overrides: FENG_SHUI_AI_MODEL (default openai/gpt-oss-120b on Groq), FENG_SHUI_STT_MODEL (default whisper-large-v3 on Groq).
