# Copy to .env.local and fill in. Leave Supabase empty to run in demo mode.

# Supabase → Project Settings → API (or "Connect" button)
NEXT_PUBLIC_SUPABASE_URL=
# New projects show a "publishable" key; older ones show "anon". Either works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: public URL used in auth emails. Vercel sets this automatically in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI via Vercel AI Gateway. On Vercel it authenticates automatically (OIDC).
# Locally: create a key at vercel.com → AI Gateway, or run `vercel env pull`.
AI_GATEWAY_API_KEY=
# Any gateway model id, e.g. anthropic/claude-sonnet-5.5, openai/gpt-5, google/gemini-3-flash
AI_MODEL=anthropic/claude-sonnet-5.5

# Mochi's brain on Groq (free tier, fast). When set, Mochi uses Groq instead of the AI Gateway.
# console.groq.com → API Keys. Models must support structured outputs (json_schema).
GROQ_API_KEY=
# Models to try in order when one hits the free 8k tokens/minute limit.
GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b

# CAMB AI text-to-speech: Mochi's spoken voice on /onboarding (server only, never NEXT_PUBLIC_).
# Get a key at https://studio.camb.ai (sign in → account settings → generate an API key). Leave empty and
# the page speaks with the browser's own voice. Docs: https://docs.camb.ai/getting-started/authentication
CAMB_API_KEY=
# Voice per reply language (integer ids from CAMB Studio's voice library or
# GET https://client.camb.ai/apis/list-voices). Pick Malaysian-accented voices. CAMB_VOICE_ID is the
# fallback for any language left empty; 144295 is the docs' default voice.
CAMB_VOICE_ID=147324
CAMB_VOICE_ID_EN=
CAMB_VOICE_ID_MS=
CAMB_VOICE_ID_ZH=
CAMB_VOICE_ID_TA=
# Accent locale per language (https://docs.camb.ai/language-support). CAMB has no en-my, so English
# defaults to en-sg; Malay ms-my, Mandarin zh-cn, Tamil ta-my (Malaysian Tamil).
CAMB_LANG_EN=en-sg
CAMB_LANG_MS=ms-my
CAMB_LANG_ZH=zh-cn
CAMB_LANG_TA=ta-my
# mars-8.1-flash-beta (fast, 312 locales incl. ms-my/ta-my/en-sg) | mars-8.1-pro-beta | mars-flash | mars-pro
CAMB_SPEECH_MODEL=mars-8.1-flash-beta

# ── Mochi's LIVE voice call on /onboarding (Agora Conversational AI Engine) ─────────────────────────
# With these set, /onboarding shows "Call Mochi": a hands-free call where the buyer just talks and Mochi
# answers on the spot (Agora does listening, turn-taking, barge-in and speech). Leave them empty and the
# page falls back to tap-to-talk (Groq Whisper + CAMB voice above). Everything here stays on the server.
# Docs: https://docs.agora.io/en/api-reference/api-ref/conversational-ai/join
#
# 1) Agora Console (https://console.agora.io) → Projects → your project (authentication: "Secured mode:
#    APP ID + Token") → copy the App ID and the Primary Certificate.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
# 2) Agora Console → Developer Toolkit → RESTful API → "Add a secret" → Customer ID + Customer Secret
#    (download the CSV; the secret is shown once). Then in the project: All features → Conversational AI
#    → enable it.
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=

# LLM (what Mochi says). Default: Groq's OpenAI-compatible endpoint with GROQ_API_KEY (set above) and
# openai/gpt-oss-120b. Groq's free tier allows 8k tokens/min per model, enough for a demo call; the
# form-filling note-taker (/api/mochi/extract) runs on other Groq models (MOCHI_EXTRACT_MODELS) so the
# two don't share a budget. Override only to use another OpenAI-compatible provider.
AGORA_LLM_URL=
AGORA_LLM_API_KEY=
AGORA_LLM_MODEL=
MOCHI_EXTRACT_MODELS=

# Speech-to-text. Best for Malaysians: Speechmatics' "cmn_en_ms_ta" pack (English, Malay, Mandarin and
# Tamil, mixed mid-sentence). Key: https://portal.speechmatics.com → API Keys (free tier has monthly
# hours). With no key, Agora's own ARES recogniser is used (no key, but one language: en-US).
SPEECHMATICS_API_KEY=
# Optional: speechmatics | ares | microsoft (default: speechmatics when its key is set, else ares).
AGORA_ASR_VENDOR=
# Optional: language code for the chosen ASR (default cmn_en_ms_ta / en-US / ms-MY).
AGORA_ASR_LANGUAGE=
# Optional regional endpoint, e.g. wss://eu2.rt.speechmatics.com/v2
SPEECHMATICS_RT_URL=

# Mochi's voice on the call: a cute, youthful, slightly robotic voice that also speaks BM and Mandarin.
# With no voice key at all, the call uses Agora's own hosted MiniMax voice (credential_mode "managed",
# included in Agora's per-minute price, 300 free minutes). Tune it with MINIMAX_VOICE_ID / MINIMAX_PITCH.
MINIMAX_VOICE_ID=
MINIMAX_PITCH=
# Recommended: ElevenLabs (Flash v2.5 speaks English, Malay, Mandarin and Tamil, ~75 ms latency).
#   Key: https://elevenlabs.io/app/settings/api-keys (a paid plan, Starter or up, is needed for live use).
#   Voice: ElevenLabs → Voices → "Voice Design", prompt e.g. "A small, cute, cheerful robot helper with a
#   bright, youthful, high-pitched voice and a light, playful synthetic shimmer. Friendly and clear."
#   Save it (or pick a cute/robot voice in the Voice Library), then copy its Voice ID here.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# Optional: elevenlabs | openai | microsoft | camb | minimax. Default: the first one whose keys are set
# (elevenlabs, then camb, then openai, then microsoft), else Agora-managed minimax.
AGORA_TTS_VENDOR=
# Alternative: OpenAI gpt-4o-mini-tts with a "cute little robot" style prompt (https://platform.openai.com/api-keys).
OPENAI_API_KEY=
OPENAI_TTS_VOICE=coral
OPENAI_TTS_INSTRUCTIONS=
# Alternative: CAMB (reuses CAMB_API_KEY and the CAMB voices above) through our /api/agora/tts proxy.
# Agora's cloud must reach it, so it only works on a public HTTPS deployment (not localhost):
# AGORA_PUBLIC_BASE_URL=https://your-app.vercel.app and a long random AGORA_TTS_PROXY_SECRET
# (e.g. `openssl rand -hex 32`).
AGORA_PUBLIC_BASE_URL=
AGORA_TTS_PROXY_SECRET=
# Alternative: Azure Speech (also usable for ASR). Child voices only exist for English/Mandarin
# (en-US-AnaNeural, zh-CN-XiaoyouNeural); there is no cute Malay voice.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia
AZURE_TTS_VOICE=

# First Key map: URL (or site path, e.g. /tiles/klang-valley-z15.pmtiles) of our own PMTiles basemap. Leave empty and /find still renders the township on a plain background.
NEXT_PUBLIC_PMTILES_URL=

# Landing map: Mapbox GL JS (Standard style) public token (pk.…). Empty = the MapLibre/OpenFreeMap map is used.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Feng Shui Builder AI (command box + voice). With GROQ_API_KEY set, both run on Groq; without it they use the AI Gateway.
GROQ_API_KEY=
# Optional overrides: FENG_SHUI_AI_MODEL (default openai/gpt-oss-120b on Groq), FENG_SHUI_STT_MODEL (default whisper-large-v3 on Groq).
